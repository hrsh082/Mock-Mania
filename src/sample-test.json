        {
          "id": "quant-1",
          "questionText": "A tank is normally filled by a pipe in 6 hours. Due to a leak at the bottom, it takes 8 hours to fill the tank. If the tank is completely full, in how many hours will the leak empty the full tank?",
          "passage": null,
          "options": [
            { "label": "A", "text": "14 hours" },
            { "label": "B", "text": "24 hours" },
            { "label": "C", "text": "18 hours" },
            { "label": "D", "text": "12 hours" },
            { "label": "E", "text": "20 hours" }
          ],
          "correctAnswer": "B",
          "explanation": "Rate of pipe = 1/6 tank/hr. Combined rate of pipe and leak = 1/8 tank/hr. Leak rate = 1/6 - 1/8 = (4-3)/24 = 1/24 tank/hr. Thus, the leak will empty the tank in 24 hours."
        },
        {
          "id": "quant-2",
          "questionText": "Three partners X, Y, and Z start a business by investing Rs. 20,000, Rs. 28,000, and Rs. 36,000 respectively. If the total profit earned at the end of the year is Rs. 10,500, what is Z's share of the profit?",
          "passage": null,
          "options": [
            { "label": "A", "text": "Rs. 3,500" },
            { "label": "B", "text": "Rs. 2,500" },
            { "label": "C", "text": "Rs. 4,500" },
            { "label": "D", "text": "Rs. 5,000" },
            { "label": "E", "text": "Rs. 3,000" }
          ],
          "correctAnswer": "C",
          "explanation": "Ratio of investment = 20:28:36 = 5:7:9. Sum of ratio parts = 5 + 7 + 9 = 21. Z's share = (9 / 21) * 10500 = 9 * 500 = Rs. 4,500."
        },
